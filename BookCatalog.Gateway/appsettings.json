{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Gateway": {
    "DiscoveryUrl": "http://localhost:18090",
    "ServiceName": "bookcatalog-api",
    "DiscoveryPollSeconds": 2,
    "HealthCheckSeconds": 3,
    "UpstreamTimeoutSeconds": 10,
    "MaxAttempts": 3,
    "CircuitFailureThreshold": 3,
    "CircuitOpenSeconds": 15,
    "MaxConcurrency": 4,
    "QueueTimeoutSeconds": 30,
    "CacheTtlSeconds": 30,
    "BalancingMode": "RoundRobin",
    "DockerSocket": "/var/run/docker.sock",
    "ComposeProject": "bookcatalog",
    "ProtectedServices": [ "gateway", "nginx" ],
    "HiddenServicePrefixes": [ "mongo-init", "seed" ],
    "SelfBaseUrl": "http://localhost:8080"
  }
}
