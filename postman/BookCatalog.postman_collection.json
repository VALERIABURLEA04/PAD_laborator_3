    {
      "name": "4. Load balancing (round robin / sticky)",
      "item": [
        {
          "name": "Round robin — repeat 6x, watch X-Api-Instance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cache-Control",
                "value": "no-cache"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/671000000000000000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "671000000000000000000001"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('Served by', pm.response.headers.get('X-Api-Instance'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sticky with X-Client-Id — always same node",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cache-Control",
                "value": "no-cache"
              },
              {
                "key": "X-Client-Id",
                "value": "vasile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/671000000000000000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "671000000000000000000001"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sticky', () => pm.expect(pm.response.headers.get('X-Balancing')).to.eql('sticky'));",
                  "console.log('Served by', pm.response.headers.get('X-Api-Instance'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Switch global mode to Sticky",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
