{
  "info": {
    "name": "BookCatalog — PAD Lab 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API + Smart Proxy (Nginx -> gateway -> api1..3). Rulează folderele în ordine. baseUrl = Nginx (8080)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "discoveryUrl",
      "value": "http://localhost:18090"
    },
    {
      "key": "bookId",
      "value": "671000000000000000000001"
    }
  ],
  "item": [
    {
      "name": "1. CRUD (JSON)",
      "item": [
        {
          "name": "GET all books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Foundation\",\n  \"author\": \"Isaac Asimov\",\n  \"publishedYear\": 1951,\n  \"description\": \"A science fiction novel.\",\n  \"tags\": [\n    \"science fiction\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const id = pm.response.headers.get('Content-Type').includes('xml')",
                  "  ? pm.response.text().match(/<Id>([0-9a-f]{24})<\\/Id>/)[1]",
                  "  : pm.response.json().id;",
                  "pm.collectionVariables.set('bookId', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET book by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
